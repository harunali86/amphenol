<style id="wp-custom-css">
body .price_slider_wrapper .price_slider_amount button,
.price_slider_wrapper .price_slider_amount button,  body.woocommerce div.product form.cart .button, body.woocommerce div.product .woocommerce-tabs ul.tabs li:hover a, 
body.woocommerce div.product .woocommerce-tabs ul.tabs li.active,

body:not(.woocommerce-block-theme-has-button-styles) .wc-block-components-button:not(.is-link),
body.woocommerce button.button,
body:not(.woocommerce-block-theme-has-button-styles) .wc-block-components-button:not(.is-link), 
body.woocommerce button.button.alt,
body.woocommerce a.button, body.woocommerce .wc-forward,
body.woocommerce a.button.alt
{
	 color: #fff !important;
}
</style>
